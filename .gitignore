node_modules/
dist/
.godot/
*.import
.env

# Debug screenshots from the --*shot flags
shots/

# Raw avatar render frames (tools/avatars/render_avatars.py); the packed sheets live in apps/mobile/assets/avatars
tools/avatars/frames/

# Intermediate decode of the Joker roar (tools/audio/decode_mp3.gd)
tools/audio/_roar_raw.f32

# Scratch renders / reviews for the Joker lion (tools/blender/make_joker.py)
tools/blender/_joker_scratch/

# Blender-rendered Joker sprite sheets: not tracked, regenerate with tools/blender/make_joker.py + pack_joker.py
# (without them the game falls back to the flat lion). meta.json stays tracked.
apps/mobile/assets/joker/*.png

# Review / preview exports that the game never loads
tools/avatars/previews/
sounds-preview/

# Preview GIF of the crown loop (the game only loads crown.png + crown.json)
apps/mobile/assets/crown/crown.gif
tools/blender/_logo_out/
