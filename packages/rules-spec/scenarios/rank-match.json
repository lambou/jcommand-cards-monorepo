[
  {
    "name": "same-rank-switches-suit",
    "description": "5 of Hearts can be played on 5 of Diamonds; the new required suit is Hearts.",
    "setup": {
      "players": [
        "A",
        "B"
      ],
      "hands": {
        "A": [
          "5H",
          "3S"
        ],
        "B": [
          "4D",
          "8H"
        ]
      },
      "stack": [
        "5D"
      ]
    },
    "steps": [
      {
        "player": "A",
        "action": "play",
        "card": "5H",
        "expect": {
          "required": "H",
          "stackTop": "5H",
          "current": "B"
        }
      },
      {
        "player": "B",
        "action": "play",
        "card": "4D",
        "expectError": true
      },
      {
        "player": "B",
        "action": "play",
        "card": "8H",
        "expect": {
          "required": "H"
        }
      }
    ]
  },
  {
    "name": "different-rank-and-suit-is-still-illegal",
