  {
    "name": "joker-on-joker-after-the-penalty-was-taken",
    "description": "A plays a Joker, B cannot block and draws 4, then C may play the other Joker on it (a Joker matches a Joker whatever its color).",
    "setup": {
      "players": [
        "A",
        "B",
        "C"
      ],
      "hands": {
        "A": [
          "JR",
          "3H"
        ],
        "B": [
          "5C",
          "6C"
        ],
        "C": [
          "JB",
          "4D"
        ]
      },
      "bank": [
        "KD",
        "KC",
        "QS",
        "QH"
      ],
      "stack": [
        "9H"
      ]
    },
    "steps": [
      {
        "player": "A",
        "action": "play",
        "card": "JR",
        "expect": {
          "pending": 4,
          "required": "red",
          "current": "B"
        }
      },
      {
        "player": "B",
        "action": "takePenalty",
        "expect": {
          "pending": 0,
          "current": "C",
          "handSizes": {
            "B": 6
          }
        }
      },
      {
        "player": "C",
        "action": "play",
        "card": "JB",
        "expect": {
          "pending": 4,
          "required": "black",
          "stackTop": "JB",
          "current": "A"
        }
      }
    ]
  },
  {
    "name": "joker-needs-a-matching-color-on-a-non-joker-card",
    "description": "Joker-on-Joker is the only exception: on any other card a Joker still needs its own color.",
    "setup": {
      "players": [
        "A",
        "B"
      ],
      "hands": {
        "A": [
          "JB",
          "3H"
        ],
        "B": [
          "4H"
        ]
      },
      "stack": [
        "9H"
      ]
    },
    "steps": [
      {
        "player": "A",
        "action": "play",
        "card": "JB",
        "expectError": true
      }
    ]
  }
]
